{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os.invalid/contracts/semantics/definitions-1.0.0.schema.json",
  "$defs": {
    "target": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "path"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "git"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "repository": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "uri",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "uri"
            },
            "uri": {
              "type": "string",
              "format": "uri"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "fixedTarget": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "path",
            "commit"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "git"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "repository": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "uri",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "uri"
            },
            "uri": {
              "type": "string",
              "format": "uri"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "fixedRef": {
      "type": "object",
      "required": [
        "target",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "target": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "kind",
                "path",
                "commit"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "git"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "repository": {
                  "type": "string",
                  "format": "uri"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "kind",
                "uri",
                "sha256"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "uri"
                },
                "uri": {
                  "type": "string",
                  "format": "uri"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "component": {
      "type": "object",
      "required": [
        "name",
        "version",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "scope": {
      "oneOf": [
        {
          "const": "whole_subject"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:|/(?:[^~]|~[01])*)$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      ]
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "activity",
          "inputs"
        ],
        "additionalProperties": false,
        "properties": {
          "activity": {
            "type": "string",
            "minLength": 1
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "target",
                "sha256"
              ],
              "additionalProperties": false,
              "properties": {
                "target": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": [
                        "kind",
                        "path",
                        "commit"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "kind": {
                          "const": "git"
                        },
                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "commit": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{40}$"
                        },
                        "repository": {
                          "type": "string",
                          "format": "uri"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "kind",
                        "uri",
                        "sha256"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "kind": {
                          "const": "uri"
                        },
                        "uri": {
                          "type": "string",
                          "format": "uri"
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        }
                      }
                    }
                  ]
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "minItems": 1
          },
          "generator": {
            "type": "object",
            "required": [
              "name",
              "version",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
