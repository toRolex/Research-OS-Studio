{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os.invalid/contracts/semantics/migration-rule-1.0.0.schema.json",
  "type": "object",
  "required": [
    "contract",
    "target",
    "type",
    "spec"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "research-os/artifact"
        },
        "version": {
          "enum": [
            "1.0.0",
            "1.1.0"
          ]
        }
      }
    },
    "target": {
      "$ref": "definitions-1.0.0.schema.json#/$defs/target"
    },
    "type": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "migration-rule"
        },
        "version": {
          "const": "1.0.0"
        }
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "artifact_type",
        "source",
        "target_version",
        "migrator",
        "input_validator",
        "output_validator"
      ],
      "additionalProperties": false,
      "properties": {
        "artifact_type": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "required": [
            "min",
            "min_inclusive",
            "max",
            "max_inclusive"
          ],
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
            },
            "min_inclusive": {
              "type": "boolean"
            },
            "max": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
            },
            "max_inclusive": {
              "type": "boolean"
            }
          }
        },
        "target_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "migrator": {
          "$ref": "definitions-1.0.0.schema.json#/$defs/component"
        },
        "input_validator": {
          "$ref": "definitions-1.0.0.schema.json#/$defs/component"
        },
        "output_validator": {
          "$ref": "definitions-1.0.0.schema.json#/$defs/component"
        }
      }
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "$ref": "definitions-1.0.0.schema.json#/$defs/provenance"
    },
    "assurance": {
      "type": "array",
      "items": {
        "$ref": "definitions-1.0.0.schema.json#/$defs/fixedRef"
      }
    }
  }
}
