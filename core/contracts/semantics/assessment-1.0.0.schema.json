{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os.invalid/contracts/semantics/assessment-1.0.0.schema.json",
  "type": "object",
  "required": [
    "contract",
    "target",
    "type",
    "spec"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "research-os/artifact"
        },
        "version": {
          "enum": [
            "1.0.0",
            "1.1.0"
          ]
        }
      }
    },
    "target": {
      "$ref": "definitions-1.0.0.schema.json#/$defs/target"
    },
    "type": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "assessment"
        },
        "version": {
          "const": "1.0.0"
        }
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "project",
        "subject",
        "dimension",
        "scope",
        "verdict",
        "method",
        "evidence",
        "assessor",
        "assessed_at",
        "validity"
      ],
      "additionalProperties": false,
      "properties": {
        "project": {
          "$ref": "definitions-1.0.0.schema.json#/$defs/fixedRef"
        },
        "subject": {
          "$ref": "definitions-1.0.0.schema.json#/$defs/fixedRef"
        },
        "dimension": {
          "enum": [
            "structural_conformance",
            "empirical_reproducibility",
            "mathematical_argument_review",
            "formal_verification",
            "independent_review",
            "human_acceptance"
          ]
        },
        "scope": {
          "$ref": "definitions-1.0.0.schema.json#/$defs/scope"
        },
        "verdict": {
          "enum": [
            "pass",
            "fail",
            "inconclusive",
            "not_applicable"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "definitions-1.0.0.schema.json#/$defs/fixedRef"
          },
          "minItems": 1
        },
        "assessor": {
          "type": "string",
          "minLength": 1
        },
        "assessed_at": {
          "type": "string",
          "format": "date-time"
        },
        "validity": {
          "enum": [
            "active",
            "superseded",
            "revoked",
            "expired"
          ]
        },
        "validity_reason": {
          "type": "string",
          "minLength": 1
        },
        "isolation_receipt": {
          "type": "object",
          "required": [
            "reviewer",
            "authors",
            "inputs",
            "fresh_context",
            "conversation_history_access",
            "issued_at"
          ],
          "additionalProperties": false,
          "properties": {
            "reviewer": {
              "type": "string",
              "minLength": 1
            },
            "authors": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "inputs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "definitions-1.0.0.schema.json#/$defs/fixedRef"
              }
            },
            "fresh_context": {
              "const": true
            },
            "conversation_history_access": {
              "const": false
            },
            "issued_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "dimension": {
                "const": "independent_review"
              }
            },
            "required": [
              "dimension"
            ]
          },
          "then": {
            "required": [
              "isolation_receipt"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "dimension": {
                "const": "human_acceptance"
              }
            },
            "required": [
              "dimension"
            ]
          },
          "then": {
            "properties": {
              "verdict": {
                "const": "pass"
              },
              "isolation_receipt": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "validity": {
                "const": "active"
              }
            },
            "required": [
              "validity"
            ]
          },
          "then": {
            "properties": {
              "validity_reason": false
            }
          },
          "else": {
            "required": [
              "validity_reason"
            ]
          }
        }
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "$ref": "definitions-1.0.0.schema.json#/$defs/provenance"
    },
    "assurance": {
      "type": "array",
      "items": {
        "$ref": "definitions-1.0.0.schema.json#/$defs/fixedRef"
      }
    }
  }
}
