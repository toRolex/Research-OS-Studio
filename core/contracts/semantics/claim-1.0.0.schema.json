{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os.invalid/contracts/semantics/claim-1.0.0.schema.json",
  "type": "object",
  "required": [
    "contract",
    "target",
    "type",
    "spec"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "research-os/artifact"
        },
        "version": {
          "enum": [
            "1.0.0",
            "1.1.0"
          ]
        }
      }
    },
    "target": {
      "$ref": "definitions-1.0.0.schema.json#/$defs/target"
    },
    "type": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "claim"
        },
        "version": {
          "const": "1.0.0"
        }
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "project",
        "workstream",
        "statement",
        "scope"
      ],
      "additionalProperties": false,
      "properties": {
        "project": {
          "$ref": "definitions-1.0.0.schema.json#/$defs/fixedRef"
        },
        "workstream": {
          "$ref": "definitions-1.0.0.schema.json#/$defs/fixedRef"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "$ref": "definitions-1.0.0.schema.json#/$defs/scope"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "$ref": "definitions-1.0.0.schema.json#/$defs/provenance"
    },
    "assurance": {
      "type": "array",
      "items": {
        "$ref": "definitions-1.0.0.schema.json#/$defs/fixedRef"
      }
    }
  }
}
