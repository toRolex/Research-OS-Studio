{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "required": ["contract", "target", "type", "spec"], "additionalProperties": false,
  "properties": {
    "contract": {"type": "object", "required": ["name", "version"], "additionalProperties": false,
      "properties": {"name": {"const": "research-os/artifact"}, "version": {"enum": ["1.0.0", "1.1.0"]}}},
    "target": {"$ref": "../foundation/target-1.0.0.schema.json"},
    "type": {"const": {"name": "publication", "version": "1.0.0"}},
    "title": {"type": "string"}, "provenance": {"type": "array"}, "assurance": {"$ref": "definitions-1.0.0.schema.json#/$defs/refs"},
    "spec": {"type": "object", "additionalProperties": false,
      "required": ["publication", "profile", "profile_version", "created_at", "project", "manuscript", "primary_text", "members", "contributions", "claims", "evidence", "conditions", "limitations", "materials", "assessments", "external_references", "required_gates"],
      "properties": {
        "publication": {"type": "string", "pattern": "^[^/]+$", "format": "research-os-git-path"},
        "profile": {"$ref": "definitions-1.0.0.schema.json#/$defs/profile"}, "profile_version": {"const": "1.0.0"},
        "created_at": {"type": "string", "pattern": "^.+T.+Z$"},
        "project": {"$ref": "definitions-1.0.0.schema.json#/$defs/ref"},
        "manuscript": {"$ref": "definitions-1.0.0.schema.json#/$defs/ref"},
        "primary_text": {"$ref": "definitions-1.0.0.schema.json#/$defs/ref"},
        "members": {"type": "array", "minItems": 1, "items": {"$ref": "definitions-1.0.0.schema.json#/$defs/member"}},
        "contributions": {"type": "array", "minItems": 1, "items": {"$ref": "definitions-1.0.0.schema.json#/$defs/text"}},
        "conditions": {"$ref": "definitions-1.0.0.schema.json#/$defs/strings"},
        "limitations": {"$ref": "definitions-1.0.0.schema.json#/$defs/strings"},
        "claims": {"type": "array", "minItems": 1, "items": {"$ref": "definitions-1.0.0.schema.json#/$defs/ref"}},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "definitions-1.0.0.schema.json#/$defs/ref"}},
        "materials": {"type": "array", "minItems": 1, "items": {"$ref": "definitions-1.0.0.schema.json#/$defs/ref"}},
        "external_references": {"$ref": "definitions-1.0.0.schema.json#/$defs/refs"},
        "assessments": {"$ref": "definitions-1.0.0.schema.json#/$defs/assessments"},
        "required_gates": {"type": "array", "items": {"$ref": "definitions-1.0.0.schema.json#/$defs/gate"}}
      }
    }
  }
}
