{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "text": {"type": "string", "minLength": 1},
    "strings": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "path": {"type": "string", "format": "research-os-git-path"},
    "target": {"oneOf": [
      {"type": "object", "required": ["kind", "path", "commit"], "additionalProperties": false,
       "properties": {"kind": {"const": "git"}, "path": {"$ref": "#/$defs/path"},
         "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
         "repository": {"type": "string", "format": "research-os-canonical-https-uri"}}},
      {"type": "object", "required": ["kind", "uri", "sha256"], "additionalProperties": false,
       "properties": {"kind": {"const": "uri"},
         "uri": {"type": "string", "format": "research-os-canonical-https-uri"},
         "sha256": {"$ref": "#/$defs/digest"}}}
    ]},
    "ref": {"type": "object", "required": ["target", "sha256"], "additionalProperties": false,
      "properties": {"target": {"$ref": "#/$defs/target"}, "sha256": {"$ref": "#/$defs/digest"}}},
    "refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "scope": {"oneOf": [{"const": "whole_subject"}, {"type": "array", "minItems": 1,
      "items": {"type": "string", "pattern": "^(?:/(?:[^~]|~[01])*)*$"}}]},
    "profile": {"enum": ["empirical-computational", "mathematical-theoretical"]},
    "dimension": {"enum": ["structural_conformance", "empirical_reproducibility", "mathematical_argument_review", "formal_verification", "independent_review", "human_acceptance"]},
    "member": {"type": "object", "required": ["path", "ref", "purpose", "role", "dependencies"], "additionalProperties": false,
      "properties": {"path": {"$ref": "#/$defs/path"}, "ref": {"$ref": "#/$defs/ref"},
        "purpose": {"$ref": "#/$defs/text"}, "role": {"enum": ["artifact", "primary-text", "material"]},
        "dependencies": {"$ref": "#/$defs/refs"}}},
    "gate": {"type": "object", "required": ["dimension", "subject", "scope"], "additionalProperties": false,
      "properties": {"dimension": {"$ref": "#/$defs/dimension"}, "subject": {"$ref": "#/$defs/ref"}, "scope": {"$ref": "#/$defs/scope"}}},
    "assessments": {"type": "object", "additionalProperties": false,
      "required": ["structural_conformance", "empirical_reproducibility", "mathematical_argument_review", "formal_verification", "independent_review", "human_acceptance"],
      "properties": {"structural_conformance": {"$ref": "#/$defs/refs"}, "empirical_reproducibility": {"$ref": "#/$defs/refs"},
        "mathematical_argument_review": {"$ref": "#/$defs/refs"}, "formal_verification": {"$ref": "#/$defs/refs"},
        "independent_review": {"$ref": "#/$defs/refs"}, "human_acceptance": {"$ref": "#/$defs/refs"}}}
  }
}
