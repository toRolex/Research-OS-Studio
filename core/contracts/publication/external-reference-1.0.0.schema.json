{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "required": ["contract", "target", "type", "spec"], "additionalProperties": false,
  "properties": {
    "contract": {"type": "object", "required": ["name", "version"], "additionalProperties": false,
      "properties": {"name": {"const": "research-os/artifact"}, "version": {"enum": ["1.0.0", "1.1.0"]}}},
    "target": {"$ref": "../foundation/target-1.0.0.schema.json"},
    "type": {"const": {"name": "external-reference", "version": "1.0.0"}},
    "title": {"type": "string"}, "provenance": {"type": "array"}, "assurance": {"$ref": "definitions-1.0.0.schema.json#/$defs/refs"},
    "spec": {"type": "object", "required": ["target", "purpose", "required_scope", "receipt"], "additionalProperties": false,
      "properties": {
        "target": {"$ref": "definitions-1.0.0.schema.json#/$defs/target"},
        "purpose": {"$ref": "definitions-1.0.0.schema.json#/$defs/text"},
        "required_scope": {"$ref": "definitions-1.0.0.schema.json#/$defs/scope"},
        "receipt": {"type": "object", "additionalProperties": false,
          "required": ["retrieved_at", "resolved_locator", "sha256", "content", "license", "log"],
          "properties": {
            "retrieved_at": {"type": "string", "pattern": "^.+T.+Z$"},
            "resolved_locator": {"$ref": "definitions-1.0.0.schema.json#/$defs/target"},
            "sha256": {"$ref": "definitions-1.0.0.schema.json#/$defs/digest"},
            "content": {"$ref": "definitions-1.0.0.schema.json#/$defs/ref"},
            "license": {"$ref": "definitions-1.0.0.schema.json#/$defs/ref"},
            "log": {"$ref": "definitions-1.0.0.schema.json#/$defs/ref"}
          }
        }
      }
    }
  }
}
