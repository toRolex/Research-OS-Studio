{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os.invalid/contracts/artifact-1.1.0.schema.json",
  "title": "Research OS Artifact 1.1.0",
  "type": "object",
  "required": [
    "contract",
    "target",
    "type",
    "spec"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "research-os/artifact"
        },
        "version": {
          "const": "1.1.0"
        }
      }
    },
    "target": {
      "$ref": "foundation/target-1.0.0.schema.json"
    },
    "type": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "version": {
          "$ref": "foundation/semver-1.0.0.schema.json"
        }
      }
    },
    "spec": {
      "type": "object"
    },
    "title": {
      "type": "string"
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "assurance": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
