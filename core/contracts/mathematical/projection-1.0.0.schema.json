{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os.dev/contracts/mathematical/projection-1.0.0.schema.json",
  "description": "Fixed original math record bytes plus independently revalidated typed handoffs; does not imply human acceptance.",
  "type": "object",
  "required": ["contract", "target", "type", "spec", "provenance"],
  "additionalProperties": false,
  "properties": {
    "contract": {"type": "object", "required": ["name", "version"], "additionalProperties": false,
      "properties": {"name": {"const": "research-os/artifact"}, "version": {"enum": ["1.0.0", "1.1.0"]}}},
    "target": {"$ref": "../foundation/target-1.0.0.schema.json"},
    "type": {"type": "object", "required": ["name", "version"], "additionalProperties": false,
      "properties": {"name": {"enum": ["math-statement-projection", "math-proof-projection", "math-review-projection"]}, "version": {"const": "1.0.0"}}},
    "title": {"type": "string"},
    "assurance": {"$ref": "../publication/definitions-1.0.0.schema.json#/$defs/refs"},
    "provenance": {"type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["activity", "inputs"], "additionalProperties": false,
        "properties": {"activity": {"const": "ordinary-math-record-projection"},
          "inputs": {"$ref": "../publication/definitions-1.0.0.schema.json#/$defs/refs"}}}},
    "spec": {"type": "object", "required": ["project", "workstream", "record", "record_digest", "subject_digest", "revision", "inputs"], "additionalProperties": false,
      "properties": {
        "project": {"$ref": "../publication/definitions-1.0.0.schema.json#/$defs/ref"},
        "workstream": {"$ref": "../publication/definitions-1.0.0.schema.json#/$defs/ref"},
        "record": {"$ref": "../publication/definitions-1.0.0.schema.json#/$defs/ref"},
        "record_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "subject_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "revision": {"type": "integer"},
        "inputs": {"type": "object", "additionalProperties": false, "properties": {
          "statement": {"$ref": "../publication/definitions-1.0.0.schema.json#/$defs/ref"},
          "proof": {"$ref": "../publication/definitions-1.0.0.schema.json#/$defs/ref"}}}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"type": {"properties": {"name": {"const": "math-statement-projection"}}}}},
     "then": {"properties": {"spec": {"properties": {"inputs": {"const": {}}}}}}},
    {"if": {"properties": {"type": {"properties": {"name": {"const": "math-proof-projection"}}}}},
     "then": {"properties": {"spec": {"properties": {"inputs": {"required": ["statement"], "additionalProperties": false, "properties": {"statement": {"$ref": "../publication/definitions-1.0.0.schema.json#/$defs/ref"}}}}}}}},
    {"if": {"properties": {"type": {"properties": {"name": {"const": "math-review-projection"}}}}},
     "then": {"properties": {"spec": {"properties": {"inputs": {"required": ["statement", "proof"]}}}}}}
  ]
}
