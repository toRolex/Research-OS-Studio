{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os.invalid/contracts/ports/port-1.0.0.schema.json",
  "title": "Local PORT admission manifest 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "id", "origin", "source", "licensing", "snapshot", "baseline", "adapted", "original", "ledger", "evaluation", "review", "decision", "decision_principal", "decision_evidence", "product"],
  "properties": {
    "contract": {"const": {"name": "research-os/port", "version": "1.0.0"}},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$"},
    "origin": {"enum": ["external", "fixture-only/not-shippable"]},
    "source": {"oneOf": [{"$ref": "#/$defs/source"}, {"$ref": "#/$defs/unavailable"}]},
    "licensing": {"oneOf": [{"$ref": "#/$defs/licensing"}, {"$ref": "#/$defs/unavailable"}]},
    "snapshot": {"$ref": "#/$defs/tree"},
    "baseline": {"$ref": "#/$defs/tree"},
    "adapted": {"$ref": "#/$defs/tree"},
    "original": {
      "type": "object", "additionalProperties": false, "required": ["behavior", "dependencies"],
      "properties": {
        "behavior": {"$ref": "#/$defs/file"},
        "dependencies": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["name", "version", "purpose"],
          "properties": {"name": {"$ref": "#/$defs/text"}, "version": {"$ref": "#/$defs/text"}, "purpose": {"$ref": "#/$defs/text"}}
        }}
      }
    },
    "ledger": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["action", "path", "reason"],
      "properties": {"action": {"enum": ["keep", "modify", "delete", "add"]}, "path": {"$ref": "#/$defs/path"}, "reason": {"$ref": "#/$defs/text"}}
    }},
    "evaluation": {
      "type": "object", "additionalProperties": false, "required": ["harness", "environment", "baseline", "adapted"],
      "properties": {
        "harness": {"$ref": "#/$defs/file"}, "environment": {"$ref": "#/$defs/file"},
        "baseline": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/run"}},
        "adapted": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/run"}}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false, "required": ["principal", "reviewed_at", "rationale"],
      "properties": {"principal": {"type": "string", "pattern": "^(person|service|fixture):[A-Za-z0-9][A-Za-z0-9@._/-]*$"}, "reviewed_at": {"$ref": "#/$defs/time"}, "rationale": {"$ref": "#/$defs/text"}}
    },
    "decision": {"enum": ["preserve", "adapt", "reject"]},
    "decision_principal": {"type": "string", "pattern": "^person:[A-Za-z0-9][A-Za-z0-9@._/-]*$"},
    "decision_evidence": {"$ref": "#/$defs/file"},
    "product": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/file"}]}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "path": {"type": "string", "format": "port-path"},
    "time": {"type": "string", "format": "port-timestamp"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/digest"}}
    },
    "tree": {
      "type": "object", "additionalProperties": false, "required": ["path", "files"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}}}
    },
    "unavailable": {
      "type": "object", "additionalProperties": false, "required": ["status", "reason"],
      "properties": {"status": {"const": "unavailable"}, "reason": {"$ref": "#/$defs/text"}}
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["status", "url", "commit", "path", "retrieved_at", "evidence"],
      "properties": {
        "status": {"const": "available"}, "url": {"type": "string", "format": "port-source-url"},
        "commit": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
        "path": {"$ref": "#/$defs/path"}, "retrieved_at": {"$ref": "#/$defs/time"}, "evidence": {"$ref": "#/$defs/file"}
      }
    },
    "licensing": {
      "type": "object", "additionalProperties": false, "required": ["status", "spdx", "license", "notice"],
      "properties": {
        "status": {"const": "available"}, "spdx": {"type": "string", "format": "port-spdx"}, "license": {"$ref": "#/$defs/file"},
        "notice": {"oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["status", "file"], "properties": {"status": {"const": "included"}, "file": {"$ref": "#/$defs/file"}}},
          {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "not-required"}, "reason": {"$ref": "#/$defs/text"}}}
        ]}
      }
    },
    "run": {
      "type": "object", "additionalProperties": false, "required": ["run_id", "executed_at", "subject_sha256", "result", "detail", "evidence"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}, "executed_at": {"$ref": "#/$defs/time"},
        "subject_sha256": {"$ref": "#/$defs/digest"}, "result": {"enum": ["pass", "fail"]}, "detail": {"$ref": "#/$defs/file"}, "evidence": {"$ref": "#/$defs/file"}
      }
    }
  }
}
