{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os.invalid/contracts/ports/evaluation-detail-1.0.0.schema.json",
  "title": "Port evaluation detail 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "kind", "subject_sha256", "tree_sha256", "result", "checks"],
  "properties": {
    "contract": {"const": {"name": "research-os/port-evaluation-detail", "version": "1.0.0"}},
    "kind": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "subject_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result": {"enum": ["pass", "fail"]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "pass"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "pass": {"type": "boolean"}
        }
      }
    }
  }
}
