{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os.invalid/contracts/ports/release-1.0.0.schema.json",
  "title": "PORT release inventory and exact allowlist 1.0.0",
  "type": "object", "additionalProperties": false, "required": ["contract", "products", "allowlist"],
  "properties": {
    "contract": {"const": {"name": "research-os/port-release", "version": "1.0.0"}},
    "products": {"type": "array", "minItems": 1, "items": {"$ref": "port-1.0.0.schema.json#/$defs/file"}},
    "allowlist": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["port_id", "path", "sha256"],
      "properties": {
        "port_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$"},
        "path": {"$ref": "port-1.0.0.schema.json#/$defs/path"},
        "sha256": {"$ref": "port-1.0.0.schema.json#/$defs/digest"}
      }
    }}
  }
}
