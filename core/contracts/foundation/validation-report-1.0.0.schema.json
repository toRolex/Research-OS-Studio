{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os.invalid/contracts/foundation/validation-report-1.0.0.schema.json",
  "title": "Research OS Validation Report 1.0.0",
  "type": "object",
  "required": [
    "contract",
    "validator",
    "subject",
    "verdict",
    "evidence",
    "issues"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "research-os/validation-report"
        },
        "version": {
          "const": "1.0.0"
        }
      }
    },
    "validator": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "version": {
          "$ref": "semver-1.0.0.schema.json"
        }
      }
    },
    "subject": {
      "type": "object",
      "required": [
        "target"
      ],
      "additionalProperties": false,
      "properties": {
        "target": {
          "$ref": "target-1.0.0.schema.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "usage_error",
        "blocked"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "enum": [
              "fail",
              "usage_error",
              "blocked"
            ]
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "issues": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "observation": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "instance_path": {
          "type": "string"
        },
        "data": {
          "type": "object"
        }
      }
    }
  }
}
