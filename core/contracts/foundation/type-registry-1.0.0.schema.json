{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os.invalid/contracts/foundation/type-registry-1.0.0.schema.json",
  "title": "Research OS type registry snapshot",
  "type": "object",
  "required": [
    "contract",
    "types"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "research-os/type-registry"
        },
        "version": {
          "const": "1.0.0"
        }
      }
    },
    "types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "version"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "version": {
            "$ref": "semver-1.0.0.schema.json"
          }
        }
      }
    }
  }
}
