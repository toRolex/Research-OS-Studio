{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-os.invalid/adapters/ssh/config-1.0.0.schema.json",
  "title": "Research OS remote configuration 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["backend", "host", "root", "revision", "inputs"],
  "properties": {
    "backend": {"enum": ["ssh", "slurm"]},
    "host": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$"},
    "user": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"}]},
    "root": {"type": "string", "pattern": "^/[^\\\\\\r\\n\\u0000]+$", "description": "Canonical absolute existing remote Git checkout, no empty/dot/dotdot/.git components or symlink traversal. Runtime verifies."},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "inputs": {"type": "object", "minProperties": 1, "propertyNames": {"type": "string", "minLength": 1}, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "description": "Safe relative committed paths -> SHA-256. Runtime rejects traversal/.git/symlinks; copies pinned Git blobs, never dirty worktree bytes."},
    "ssh_executable": {"type": "string", "pattern": "^(?:/[A-Za-z0-9_. /-]+|[A-Za-z0-9_][A-Za-z0-9_.-]*)$", "default": "ssh"},
    "python_executable": {"type": "string", "pattern": "^(?:/[A-Za-z0-9_. /-]+|[A-Za-z0-9_][A-Za-z0-9_.-]*)$", "default": "python3"},
    "port": {"type": "integer", "minimum": 1, "maximum": 65535, "default": 22},
    "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 3600, "default": 10},
    "max_transfer_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864, "default": 8388608},
    "slurm": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "partition": {"$ref": "#/$defs/resource"},
        "account": {"$ref": "#/$defs/resource"},
        "qos": {"$ref": "#/$defs/resource"},
        "cpus_per_task": {"$ref": "#/$defs/resource"},
        "mem": {"$ref": "#/$defs/resource"},
        "gpus": {"$ref": "#/$defs/resource", "description": "Recognized but submission BLOCKED: GPU metering is not evaluated."}
      }
    }
  },
  "allOf": [{"if": {"properties": {"backend": {"const": "ssh"}}}, "then": {"properties": {"slurm": {"maxProperties": 0}}}}],
  "$defs": {"resource": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_:.-]*$"}}
}
